{
  "name": "ai-commerce-pos",
  "version": "0.0.0",
  "private": true,
  "description": "Multi-tenant SaaS POS and AI Sales Agent platform for Myanmar SMEs",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10.33.0 <11"
  },
  "scripts": {
    "dev": "pnpm --parallel --recursive --if-present run dev",
    "build": "pnpm --recursive --if-present run build",
    "typecheck": "pnpm --recursive --if-present run typecheck",
    "lint": "pnpm --recursive --if-present run lint",
    "test": "pnpm --recursive --if-present run test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  }
}
